# Portas do Projeto no Host (Evita conflitos com outros projetos locais)
GATEWAY_PORT=4100
WEB_PORT=4101
API_PORT=4102
POSTGRES_PORT=4103

# Banco de dados PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=os_melhores_da_cidade
DATABASE_URL=postgresql://postgres:postgres@localhost:4103/os_melhores_da_cidade?schema=public

# Backend NestJS
PORT=3333
JWT_ACCESS_SECRET=chave-super-secreta-jwt-access-melhores-da-cidade
JWT_REFRESH_SECRET=chave-super-secreta-jwt-refresh-melhores-da-cidade
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:4100,http://localhost:4101

# Frontend Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:4100
NEXT_PUBLIC_API_URL=http://localhost:4100/api/v1

