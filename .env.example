# Banco de dados PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=os_melhores_da_cidade
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/os_melhores_da_cidade?schema=public

# Backend NestJS
PORT=3333
JWT_ACCESS_SECRET=chave-super-secreta-jwt-access-melhores-da-cidade
JWT_REFRESH_SECRET=chave-super-secreta-jwt-refresh-melhores-da-cidade
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Frontend Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1

